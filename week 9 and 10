    load_suppliers_text();
    load_assets_text();
    load_budgets_text();
}

// -------------------------------------------------------------
// UI & RECORD ADDITION HELPERS
// -------------------------------------------------------------
void add_sample_data() {
    emp_count = 2;
    employees[0] = (Employee){101, "Alice Ndlovu", 25000.00};
    employees[1] = (Employee){102, "Bob Smith", 18500.00};

    sup_count = 2;
    suppliers[0] = (Supplier){201, "BuildCo Namibia", 150000.00};
    suppliers[1] = (Supplier){202, "SolarTech Ltd", 85000.00};

    asset_count = 2;
    assets[0] = (Asset){301, "Municipal Truck #4", 450000.00};
    assets[1] = (Asset){302, "HQ Generator", 120000.00};

    budget_count = 2;
    budgets[0] = (Budget){"Public Works", 500000.00, 420000.00};
    budgets[1] = (Budget){"Health Services", 300000.00, 280000.00};

    printf("\nSample data added into memory.\n");
}

void display_records() {
    printf("\n================ CURRENT MFMS RECORDS ================\n");
    printf("-- EMPLOYEES (%d) --\n", emp_count);
    for (int i = 0; i < emp_count; i++)
        printf("ID: %d | Name: %-15s | Salary: NAD %.2f\n", employees[i].id, employees[i].name, employees[i].salary);

    printf("\n-- SUPPLIERS (%d) --\n", sup_count);
    for (int i = 0; i < sup_count; i++)
        printf("ID: %d | Name: %-15s | Contract: NAD %.2f\n", suppliers[i].id, suppliers[i].name, suppliers[i].contract_amount);

    printf("\n-- ASSETS (%d) --\n", asset_count);
    for (int i = 0; i < asset_count; i++)
        printf("ID: %d | Name: %-15s | Value: NAD %.2f\n", assets[i].id, assets[i].name, assets[i].value);

    printf("\n-- BUDGETS (%d) --\n", budget_count);
    for (int i = 0; i < budget_count; i++)
        printf("Dept: %-15s | Rev: NAD %.2f | Exp: NAD %.2f\n", budgets[i].department, budgets[i].revenue, budgets[i].expenses);
    printf("=====================================================\n");
}

int main() {
    create_data_directory();
    int choice;

    do {
        printf("\n=== MUNICIPAL FINANCIAL MANAGEMENT SYSTEM (Text Mode) ===\n");
        printf("1. Add Sample Data to Memory\n");
        printf("2. Display Current Memory Records\n");
        printf("3. Save Data (Text Files)\n");
        printf("4. Load Data (Text Files)\n");
        printf("5. Exit\n");
        printf("Enter your choice (1-5): ");

        if (scanf("%d", &choice) != 1) {
            while (getchar() != '\n');
            continue;
        }

        switch (choice) {
            case 1: add_sample_data(); break;
            case 2: display_records(); break;
            case 3: save_all_data_text(); break;
            case 4: load_all_data_text(); break;
            case 5: printf("Exiting system...\n"); break;
            default: printf("Invalid choice.\n");
        }
    } while (choice != 5);

    return 0;
}
