void save_all_data_text() {
    printf("\n--- Saving All System Data (Text Files) ---\n");
    save_employees_text();
    save_suppliers_text();
    save_assets_text();
    save_budgets_text();
}

// -------------------------------------------------------------
// TEXT LOAD FUNCTIONS
// -------------------------------------------------------------
void load_employees_text() {
    FILE *fp = fopen("data/employees.txt", "r");
    if (fp == NULL) {
        perror("[ERROR] Failed to open data/employees.txt for reading");
        return;
    }
    emp_count = 0;
    while (fscanf(fp, "%d,%49[^,],%lf\n", &employees[emp_count].id, employees[emp_count].name, &employees[emp_count].salary) == 3) {
        emp_count++;
        if (emp_count >= MAX_RECORDS) break;
    }
    fclose(fp);
    printf("Successfully loaded %d employee record(s).\n", emp_count);
}

