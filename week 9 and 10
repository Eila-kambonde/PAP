#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/types.h>

#define MAX_RECORDS 50
#define DATA_DIR "data"

// Data Structures
typedef struct {
    int id;
    char name[50];
    double salary;
} Employee;

typedef struct {
    int id;
    char name[50];
    double contract_amount;
} Supplier;

typedef struct {
    int id;
    char name[50];
    double value;
} Asset;

typedef struct {
    char department[50];
    double revenue;
    double expenses;
} Budget;

// Global Records & Counters
Employee employees[MAX_RECORDS];
int emp_count = 0;

Supplier suppliers[MAX_RECORDS];
int sup_count = 0;

Asset assets[MAX_RECORDS];
int asset_count = 0;

Budget budgets[MAX_RECORDS];
int budget_count = 0;

// Helper: Ensure data directory exists
void create_data_directory() {
#ifdef _WIN32
    mkdir(DATA_DIR);
#else
    mkdir(DATA_DIR, 0777);
#endif
}

// -------------------------------------------------------------
// TEXT SAVE FUNCTIONS
// -------------------------------------------------------------
void save_employees_text() {
    FILE *fp = fopen("data/employees.txt", "w");
    if (fp == NULL) {
        perror("[ERROR] Failed to open data/employees.txt for writing");
        return;
    }
    for (int i = 0; i < emp_count; i++) {
        fprintf(fp, "%d,%s,%.2f\n", employees[i].id, employees[i].name, employees[i].salary);
    }
    fclose(fp);
    printf("Successfully saved %d employee record(s) to text file.\n", emp_count);
}

