#include <stdio.h>
#include <string.h>

#define MAX_EMPLOYEES 5
#define MAX_SUPPLIERS 5

// --- Reusable Function 1: Display formatted headers ---
void print_header(const char *title) {
    printf("\n========================================\n");
    printf("     %s     \n", title);
    printf("========================================\n");
}

// --- Reusable Function 2: Calculate total expenditure from an array ---
double calculate_total(const double values[], int size) {
    double total = 0.0;
    int i;
    for (i = 0; i < size; i++) {
        total += values[i];
    }
    return total;
}

// --- Reusable Function 3: Search for an employee salary in the array ---
int search_employee_salary(const double salaries[], int size, double target) {
    int i;
    for (i = 0; i < size; i++) {
        if (salaries[i] == target) {
            return i; // Returns the index if found
        }
    }
    return -1; // Returns -1 if not found
}

// --- Module: Supplier Management ---
void run_supplier_module() {
    char supplier_names[MAX_SUPPLIERS][50];
    double contract_amounts[MAX_SUPPLIERS];
    int i;

    print_header("SUPPLIER MANAGEMENT MODULE");
    printf("Enter details for %d municipal suppliers:\n\n", MAX_SUPPLIERS);

    for (i = 0; i < MAX_SUPPLIERS; i++) {
        printf("Enter name for Supplier %d: ", i + 1);
        scanf("%49s", supplier_names[i]); // Reads a single-word string safely
        
        printf("Enter contract amount for %s (NAD): ", supplier_names[i]);
        scanf("%lf", &contract_amounts[i]);
        printf("----------------------------------------\n");
    }

    // Display Supplier Summary
    print_header("REGISTERED SUPPLIERS SUMMARY");
    for (i = 0; i < MAX_SUPPLIERS; i++) {
        printf("Supplier %d: %-15s | Contract: NAD %.2f\n", 
               i + 1, supplier_names[i], contract_amounts[i]);
    }
    
    double total_contracts = calculate_total(contract_amounts, MAX_SUPPLIERS);
    printf("\nTotal Supplier Expenditure: NAD %.2f\n", total_contracts);
}

// --- Module: Employee Salary & Search ---
void run_employee_module() {
    double employee_salaries[MAX_EMPLOYEES] = { 18500.0, 22000.0, 15000.0, 31000.0, 19500.0 };
    double search_target;
    int i, result_index;

    print_header("EMPLOYEE SALARY & SEARCH MODULE");
    
    // Display current records
    printf("Current Employee Records:\n");
    for (i = 0; i < MAX_EMPLOYEES; i++) {
        printf("Employee %d Salary: NAD %.2f\n", i + 1, employee_salaries[i]);
    }

    // Search Functionality Execution
    printf("\nEnter salary amount to search for (NAD): ");
    if (scanf("%lf", &search_target) == 1) {
        result_index = search_employee_salary(employee_salaries, MAX_EMPLOYEES, search_target);
        
        if (result_index != -1) {
            printf("[MATCH FOUND] Salary NAD %.2f belongs to Employee #%d\n", 
                   search_target, result_index + 1);
        } else {
            printf("[NOT FOUND] No employee record matches NAD %.2f\n", search_target);
        }
    }
}

// --- Main Function with Working Menu ---
int main() {
    int choice;

    do {
        print_header("MUNICIPAL FINANCIAL MANAGEMENT SYSTEM (MFMS)");
        printf("1. Run Supplier Management Module\n");
        printf("2. Run Employee Salary & Search Module\n");
        printf("3. Exit System\n");
        printf("----------------------------------------\n");
        printf("Enter your choice (1-3): ");

        if (scanf("%d", &choice) != 1) {
            printf("Invalid input. Please enter a valid number.\n");
            // Clear input buffer to prevent infinite loops on bad input
            while (getchar() != '\n');
            continue;
        }

        switch (choice) {
            case 1:
                run_supplier_module();
                break;
            case 2:
                run_employee_module();
                break;
            case 3:
                printf("\nExiting MFMS. Saving state...\n");
                printf("System closed successfully.\n");
                break;
            default:
                printf("\n[ERROR] Invalid choice. Please choose between 1 and 3.\n");
        }

        if (choice != 3) {
            printf("\nPress Enter to return to the main menu...");
            while (getchar() != '\n'); // Clear trailing newline
            getchar(); // Wait for user press
        }

    } while (choice != 3);

    return 0;
}
